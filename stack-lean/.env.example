# ---------------------------------------------------------------------------
# Copier en .env puis remplir. Ne JAMAIS versionner le .env rempli.
# Générer les secrets : openssl rand -hex 32
# Générer le hash Caddy : docker run --rm caddy:2 caddy hash-password
# ---------------------------------------------------------------------------

# --- Fournisseurs de tokens (UE, open-weights, sans réutilisation des prompts) ---
SCALEWAY_API_KEY=
MISTRAL_API_KEY=

# --- Sécurité interne ---
LITELLM_MASTER_KEY=
QDRANT_API_KEY=
WEBUI_SECRET_KEY=

# --- Portail ---
CADDY_USER=agence
CADDY_PASSWORD_HASH=

# --- Modèle proposé par défaut dans l'interface ---
DEFAULT_MODELS=agence/rapide
